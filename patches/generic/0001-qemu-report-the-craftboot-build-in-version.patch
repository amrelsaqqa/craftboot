From aecf9a7ff10f79f5c56e9ea65645bf558f8cc0ba Mon Sep 17 00:00:00 2001
From: build <build@local>
Date: Mon, 16 Nov 2026 00:14:56 +0200
Subject: [PATCH] qemu: report the CraftBoot build in --version

CraftBoot generates include/craftboot-version.h with the version the binaries
were built as; print it above QEMU's own version line.  The include is
conditional, so QEMU built without that header is unaffected and prints exactly
what it always did.
---
 system/vl.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/system/vl.c b/system/vl.c
index 5091fe5..5937cd0 100644
--- a/system/vl.c
+++ b/system/vl.c
@@ -28,6 +28,19 @@
 #include "qemu/units.h"
 #include "qemu/module.h"
 #include "qemu/target-info.h"
+
+/*
+ * CraftBoot stamps the build with the version it was released as.  The header
+ * is generated by the CraftBoot build system; QEMU built on its own (or from a
+ * plain checkout) simply has no CraftBoot line, so the include is conditional.
+ */
+#if defined(__has_include)
+# if __has_include("craftboot-version.h")
+#  include "craftboot-version.h"
+#  define HAVE_CRAFTBOOT_VERSION 1
+# endif
+#endif
+
 #include "exec/cpu-common.h"
 #include "exec/page-vary.h"
 #include "hw/qdev-properties.h"
@@ -873,6 +886,9 @@ static MachineClass *find_default_machine(GSList *machines)
 
 static void version(void)
 {
+#ifdef HAVE_CRAFTBOOT_VERSION
+    printf("Built by CraftBoot %s\n", CRAFTBOOT_VERSION);
+#endif
     printf("QEMU emulator version " QEMU_FULL_VERSION "\n"
            QEMU_COPYRIGHT "\n");
 }
