From 8ea48a7950e8bbee29aaac169342224acf67f713 Mon Sep 17 00:00:00 2001
From: Amr Elsaqqa <amrelsaqqa@hotmail.com>
Date: Sat, 14 Nov 2026 17:36:49 +0200
Subject: [PATCH 6/6] mt7621: split the machine into modules

The machine is no longer one file: mt7621.c keeps the machine (memory map,
RAM/alias windows, boot stages, reset sequencing, -M properties) and each
controller gets a module under hw/mips/mt7621/: uart, regfile (sysctl window
and GPIO), wdt, systick, board, flash (SPI NOR), nand (NFI), eth (frame
engine, MDIO/MT7530, NIC), cm (GCR/CPC), crypto (EIP-93), dump (debug knobs)
and loader (uImage/ELF).

mt7621.c goes from 5,469 to 1,082 lines.  Every move was behaviour-neutral and
boot-tested; the interface between the machine and the modules is
hw/mips/mt7621/mt7621.h, and the frame engine's private register map is
hw/mips/mt7621/eth.h.
---
 hw/mips/meson.build | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hw/mips/meson.build b/hw/mips/meson.build
index 2f2fba7..cf64a2a 100644
--- a/hw/mips/meson.build
+++ b/hw/mips/meson.build
@@ -4,7 +4,7 @@ common_ss.add(when: 'CONFIG_FW_CFG_MIPS', if_true: files('fw_cfg.c'))
 common_ss.add(when: 'CONFIG_LOONGSON3V', if_true: files('loongson3_bootp.c'))
 mips_ss.add(when: 'CONFIG_LOONGSON3V', if_true: files('loongson3_virt.c'))
 mips_ss.add(when: 'CONFIG_MALTA', if_true: files('malta.c'))
-mips_ss.add(when: 'CONFIG_MT7621', if_true: files('mt7621.c'))
+mips_ss.add(when: 'CONFIG_MT7621', if_true: files('mt7621.c', 'mt7621/uart.c', 'mt7621/regfile.c', 'mt7621/wdt.c', 'mt7621/systick.c', 'mt7621/board.c', 'mt7621/flash.c', 'mt7621/nand.c', 'mt7621/eth.c', 'mt7621/cm.c', 'mt7621/crypto.c', 'mt7621/dump.c', 'mt7621/loader.c'))
 mips_ss.add(when: 'CONFIG_MIPS_CPS', if_true: files('cps.c'))
 
 if 'CONFIG_TCG' in config_all_accel
