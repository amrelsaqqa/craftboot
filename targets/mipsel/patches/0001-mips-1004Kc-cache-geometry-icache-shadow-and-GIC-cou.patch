+/*
+ * Moves to/from shadow registers.
+ *
+ * The shadow register sets live in CPUMIPSState.tcs[]; index 0 of that array
+ * is also CPU TC0's state, so addressing the array from the start of the CPU
+ * state (as the register file base) aliases sets 1..15 onto unrelated fields
+ * such as active_tc.PC and the CP0 registers.  Address the array explicitly.
+ */
+static inline void gen_srsgpr_addr(TCGv_ptr addr, int reg)
+{
+    TCGv_i32 t2 = tcg_temp_new_i32();
+
+    tcg_gen_ld_i32(t2, tcg_env, offsetof(CPUMIPSState, CP0_SRSCtl));
+    tcg_gen_shri_i32(t2, t2, CP0SRSCtl_PSS);
+    tcg_gen_andi_i32(t2, t2, 0xf);
+    tcg_gen_muli_i32(t2, t2, sizeof(TCState));
+    tcg_gen_ext_i32_ptr(addr, t2);
+    tcg_gen_addi_ptr(addr, addr, offsetof(CPUMIPSState, tcs));
+    tcg_gen_add_ptr(addr, tcg_env, addr);
+    tcg_gen_addi_ptr(addr, addr, offsetof(TCState, gpr));
+    tcg_gen_addi_ptr(addr, addr, sizeof(target_ulong) * reg);
+}
+
 static inline void gen_load_srsgpr(int from, int to)
