+/*
+ * MT7621 (1004Kc) L1 caches: 32 KiB, 4-way, 32-byte lines, for both the
+ * instruction and the data cache.
+ *
+ * Config1.{I,D}l encode the line size as 2^(n+1), so 32 bytes is Dl=Il=4, and
+ * the generic MIPS32 probe in Linux computes sets = 32 << (Is+1), i.e. 256
+ * sets for a 4-way 32 KiB cache.  These fields matter beyond reporting:
+ * r4k_blast_icache_setup()/r4k_blast_dcache_setup() only install a blast
+ * routine for line sizes 16/32/64/128, so an implausible size (e.g. 8 bytes)
+ * leaves r4k_blast_icache NULL and the kernel's first cache flush jumps to 0.
+ * Firmware also derives DMA buffer alignment from Dl.
+ *
+ * Overridable for bring-up testing.
+ */
+#ifndef MIPS_1004KC_CACHE_IS
+#define MIPS_1004KC_CACHE_IS 2
+#endif
+#ifndef MIPS_1004KC_CACHE_IL
+#define MIPS_1004KC_CACHE_IL 4
+#endif
+#ifndef MIPS_1004KC_CACHE_IA
+#define MIPS_1004KC_CACHE_IA 3
+#endif
+#ifndef MIPS_1004KC_CACHE_DS
+#define MIPS_1004KC_CACHE_DS 2
+#endif
+#ifndef MIPS_1004KC_CACHE_DL
+#define MIPS_1004KC_CACHE_DL 4
+#endif
+#ifndef MIPS_1004KC_CACHE_DA
+#define MIPS_1004KC_CACHE_DA 3
+#endif
+
 /* CPU / CPU family specific config register values. */
 
 /* Have config1, uncached coherency */
@@ -317,6 +350,80 @@ const mips_def_t mips_defs[] =
         .insn_flags = CPU_MIPS32R2 | ASE_MIPS16 | ASE_DSP,
         .mmu_type = MMU_TYPE_R4000,
     },
+    {
+        /*
+         * MediaTek MT7621 uses a 1004Kc (34K-class, multi-threaded) core.
+         * The only functional difference from 34Kf that matters for
+         * firmware bring-up is that it must decode MIPS16: the Breed
+         * stage-1 stub is MIPS32 and JALX-es into MIPS16 code, so a CPU
+         * model that advertises microMIPS would decode that code with the
+         * wrong decoder.
+         */
+        .name = "1004Kc",
+        .CP0_PRid = 0x0001992f,
+        .CP0_Config0 = MIPS_CONFIG0 | (0x1 << CP0C0_AR) |
+                       (MMU_TYPE_R4000 << CP0C0_MT),
+        /*
+         * Dl/Il encode the cache line size as 2^(Dl+1) and Is/Is the number
+         * of sets as 32 << (Is+1).  The D-cache line size is what the
+         * firmware derives its DMA buffer alignment from, so it must match
+         * the part, not merely be plausible; Linux likewise only builds its
+         * cache-flush routines for 16/32/64/128-byte lines.
+         */
+        .CP0_Config1 = MIPS_CONFIG1 | (1 << CP0C1_FP) | (63 << CP0C1_MMU) |
+                       (MIPS_1004KC_CACHE_IS << CP0C1_IS) | (MIPS_1004KC_CACHE_IL << CP0C1_IL) |
+                       (MIPS_1004KC_CACHE_IA << CP0C1_IA) |
+                       (MIPS_1004KC_CACHE_DS << CP0C1_DS) | (MIPS_1004KC_CACHE_DL << CP0C1_DL) |
+                       (MIPS_1004KC_CACHE_DA << CP0C1_DA) |
+                       (1 << CP0C1_CA),
+        .CP0_Config2 = MIPS_CONFIG2,
+        /*
+         * A real 1004Kc implements the UserLocal register (ULRI) and the
+         * Cluster Manager (CMGCR, which also makes QEMU set CMGCRBase =
+         * 0x1fbf8000 >> 4).  MikroTik's 5.6 mmips kernel checks ULRI and then
+         * reads CMGCRBase to find the CM/GIC base; without these bits it
+         * gives up on that mapping init and later stores through a NULL base
+         * (PC 0x80410c1c, address 0xcc).
+         */
+        .CP0_Config3 = MIPS_CONFIG3 | (1 << CP0C3_VInt) | (1 << CP0C3_MT) |
+                       (1 << CP0C3_DSPP) | (1 << CP0C3_ULRI) |
+                       (1 << CP0C3_CMGCR),
+        .CP0_LLAddr_rw_bitmask = 0,
+        .CP0_LLAddr_shift = 0,
+        .SYNCI_Step = 32,
+        .CCRes = 2,
+        .CP0_Status_rw_bitmask = 0x3778FF1F,
+        .CP0_TCStatus_rw_bitmask = (0 << CP0TCSt_TCU3) | (0 << CP0TCSt_TCU2) |
+                    (1 << CP0TCSt_TCU1) | (1 << CP0TCSt_TCU0) |
+                    (0 << CP0TCSt_TMX) | (1 << CP0TCSt_DT) |
+                    (1 << CP0TCSt_DA) | (1 << CP0TCSt_A) |
+                    (0x3 << CP0TCSt_TKSU) | (1 << CP0TCSt_IXMT) |
+                    (0xff << CP0TCSt_TASID),
+        .CP1_fcr0 = (1 << FCR0_F64) | (1 << FCR0_L) | (1 << FCR0_W) |
+                    (1 << FCR0_D) | (1 << FCR0_S) | (0x92 << FCR0_PRID),
+        .CP1_fcr31 = 0,
+        .CP1_fcr31_rw_bitmask = 0xFF83FFFF,
+        .CP0_SRSCtl = (0xf << CP0SRSCtl_HSS),
+        .CP0_SRSConf0_rw_bitmask = 0x3fffffff,
+        .CP0_SRSConf0 = (1U << CP0SRSC0_M) | (0x3fe << CP0SRSC0_SRS3) |
+                    (0x3fe << CP0SRSC0_SRS2) | (0x3fe << CP0SRSC0_SRS1),
+        .CP0_SRSConf1_rw_bitmask = 0x3fffffff,
+        .CP0_SRSConf1 = (1U << CP0SRSC1_M) | (0x3fe << CP0SRSC1_SRS6) |
+                    (0x3fe << CP0SRSC1_SRS5) | (0x3fe << CP0SRSC1_SRS4),
+        .CP0_SRSConf2_rw_bitmask = 0x3fffffff,
+        .CP0_SRSConf2 = (1U << CP0SRSC2_M) | (0x3fe << CP0SRSC2_SRS9) |
+                    (0x3fe << CP0SRSC2_SRS8) | (0x3fe << CP0SRSC2_SRS7),
+        .CP0_SRSConf3_rw_bitmask = 0x3fffffff,
+        .CP0_SRSConf3 = (1U << CP0SRSC3_M) | (0x3fe << CP0SRSC3_SRS12) |
+                    (0x3fe << CP0SRSC3_SRS11) | (0x3fe << CP0SRSC3_SRS10),
+        .CP0_SRSConf4_rw_bitmask = 0x3fffffff,
+        .CP0_SRSConf4 = (0x3fe << CP0SRSC4_SRS15) |
+                    (0x3fe << CP0SRSC4_SRS14) | (0x3fe << CP0SRSC4_SRS13),
+        .SEGBITS = 32,
+        .PABITS = 32,
+        .insn_flags = CPU_MIPS32R2 | ASE_MIPS16 | ASE_DSP,
+        .mmu_type = MMU_TYPE_R4000,
+    },
     {
         .name = "74Kf",
         .CP0_PRid = 0x00019700,
