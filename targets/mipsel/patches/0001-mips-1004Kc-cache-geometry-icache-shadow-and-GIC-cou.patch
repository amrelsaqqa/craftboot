diff --git a/hw/timer/mips_gictimer.c b/hw/timer/mips_gictimer.c
index 2b0696d..ffad82b 100644
--- a/hw/timer/mips_gictimer.c
+++ b/hw/timer/mips_gictimer.c
@@ -10,11 +10,35 @@
 #include "qemu/timer.h"
 #include "hw/timer/mips_gictimer.h"
 
-#define TIMER_PERIOD 10 /* 10 ns period for 100 Mhz frequency */
+/*
+ * The GIC shared counter ticks at the SoC's "GIC frequency".  The MT7621
+ * feeds it from the CPU clock (RouterBOOT reports 875 MHz on the RB750Gr3 and
+ * OpenWrt programs its clockevents against that), which is why this has to be
+ * settable per machine instead of a fixed reference rate: with the wrong rate
+ * every guest timer fires 35x too early or too late.
+ */
+static uint32_t gictimer_freq = 25000000;
+
+void mips_gictimer_set_freq(uint32_t freq)
+{
+    gictimer_freq = freq ? freq : 25000000;
+}
 
 uint32_t mips_gictimer_get_freq(MIPSGICTimerState *gic)
 {
-    return NANOSECONDS_PER_SECOND / TIMER_PERIOD;
+    return gictimer_freq;
+}
+
+/* Convert a QEMU virtual-clock timestamp into GIC counter ticks. */
+static uint64_t gictimer_ticks(uint64_t ns)
+{
+    return muldiv64(ns, gictimer_freq, NANOSECONDS_PER_SECOND);
+}
+
+/* Convert GIC counter ticks into nanoseconds. */
+static uint64_t gictimer_ns(uint64_t ticks)
+{
+    return muldiv64(ticks, NANOSECONDS_PER_SECOND, gictimer_freq);
 }
 
 static void gic_vptimer_update(MIPSGICTimerState *gictimer,
@@ -23,9 +47,21 @@ static void gic_vptimer_update(MIPSGICTimerState *gictimer,
     uint64_t next;
     uint32_t wait;
 
+    /*
+     * 0xffffffff is the reset value of the compare register and means "not
+     * programmed".  Treating it as a real deadline made the local compare
+     * interrupt fire once per 32-bit counter wrap even though the guest never
+     * asked for it; RouterOS 3.3.5 (which only dispatches shared interrupts)
+     * then sees an interrupt it can never acknowledge and spins forever with
+     * Cause.IP2 stuck high.
+     */
+    if (gictimer->vptimers[vp_index].comparelo == 0xffffffff) {
+        timer_del(gictimer->vptimers[vp_index].qtimer);
+        return;
+    }
     wait = gictimer->vptimers[vp_index].comparelo - gictimer->sh_counterlo -
-           (uint32_t)(now / TIMER_PERIOD);
-    next = now + (uint64_t)wait * TIMER_PERIOD;
+           (uint32_t)gictimer_ticks(now);
+    next = now + gictimer_ns((uint64_t)wait);
 
     timer_mod(gictimer->vptimers[vp_index].qtimer, next);
 }
@@ -64,7 +100,7 @@ uint32_t mips_gictimer_get_sh_count(MIPSGICTimerState *gictimer)
                 gic_vptimer_expire(gictimer, i, now);
             }
         }
-        return gictimer->sh_counterlo + (uint32_t)(now / TIMER_PERIOD);
+        return gictimer->sh_counterlo + (uint32_t)gictimer_ticks(now);
     }
 }
 
@@ -78,7 +114,7 @@ void mips_gictimer_store_sh_count(MIPSGICTimerState *gictimer, uint64_t count)
     } else {
         /* Store new count register */
         now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
-        gictimer->sh_counterlo = count - (uint32_t)(now / TIMER_PERIOD);
+        gictimer->sh_counterlo = count - (uint32_t)gictimer_ticks(now);
         /* Update timer timer */
         for (i = 0; i < gictimer->num_vps; i++) {
             gic_vptimer_update(gictimer, i, now);
@@ -118,7 +154,7 @@ void mips_gictimer_stop_count(MIPSGICTimerState *gictimer)
     gictimer->countstop = 1;
     /* Store the current value */
     gictimer->sh_counterlo +=
-        (uint32_t)(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / TIMER_PERIOD);
+        (uint32_t)gictimer_ticks(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
     for (i = 0; i < gictimer->num_vps; i++) {
         timer_del(gictimer->vptimers[i].qtimer);
     }
diff --git a/include/exec/icache-shadow.h b/include/exec/icache-shadow.h
new file mode 100644
index 0000000..16a36f6
--- /dev/null
+++ b/include/exec/icache-shadow.h
@@ -0,0 +1,54 @@
+/*
+ * Minimal instruction-cache shadow (opt-in, MIPS).
+ *
+ * Real MIPS CPUs have separate I and D caches: a store does not change what
+ * the instruction fetch unit sees until the I-cache is invalidated.  Some
+ * guests rely on that.  In particular the MIPS compressed-kernel loader
+ * (arch/mips/boot/compressed/) is placed at its load address and is then
+ * *overwritten by its own decompression output*; it only survives because its
+ * instructions are still in the I-cache.  The kernel even admits it with a
+ * "FIXME: should we flush cache here?" comment.
+ *
+ * Plain TCG has no such separation: every instruction fetch reads the current
+ * RAM contents, so after the decompressor wrote over the loader the CPU
+ * re-translates those bytes as code and executes garbage.
+ *
+ * This provides a small page-granular shadow of instruction memory, consulted
+ * only for instruction fetch and only inside an address window chosen by the
+ * machine.  `cache`/`synci` instructions flush it, matching the architectural
+ * I-cache invalidation.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef EXEC_ICACHE_SHADOW_H
+#define EXEC_ICACHE_SHADOW_H
+
+#include "exec/vaddr.h"
+
+/*
+ * Enable the shadow for [lo, hi).  Pages are snapshot on their first
+ * instruction fetch.
+ */
+void icache_shadow_enable(uint64_t lo, uint64_t hi);
+
+/* Drop every snapshot. */
+void icache_shadow_flush(void);
+
+/*
+ * Drop the snapshot of the page containing @addr (one `cache`/`synci` line
+ * invalidate).  O(1), so a guest flushing line by line does not thrash.
+ */
+void icache_shadow_invalidate(uint64_t addr);
+
+/* Whether the shadow is enabled (used to decide whether to emit helpers). */
+bool icache_shadow_active(void);
+
+/*
+ * Instruction fetch: return the cached instruction word at @addr, snapshotting
+ * the containing page on first use.  Falls back to @fallback when the address
+ * is outside the enabled window or not plain RAM.
+ */
+uint32_t icache_shadow_ldl(CPUArchState *env, vaddr addr, int mmu_idx,
+                           uint32_t fallback);
+
+#endif
