+/*
+ * MT7621_RECVLOG: the netinstall agent polls its discovery sockets through
+ * the libc syscall stub at 0x432228, so sample the return value right after
+ * the stub resumes: a positive v0 is the number of bytes recvfrom() put in
+ * the buffer, which is the only reliable way to see what the agent got.
+ */
+
+void mt7621_sysret_trace(CPUMIPSState *env)
+{
+    uint32_t pc = (uint32_t)env->active_tc.PC;
+    int32_t v0 = (int32_t)env->active_tc.gpr[2];
+    char pbuf[56];
+    size_t i;
+
+    if (!mt7621_pend || pc != 0x43222c) {
+        return;
+    }
+    mt7621_pend = 0;
+    fprintf(stderr, "net ret fd=%d v0=%d", mt7621_pendfd, v0);
+    if (v0 > 0 && v0 < 1500) {
+        memset(pbuf, 0, sizeof(pbuf));
+        cpu_memory_rw_debug(env_cpu(env), mt7621_pendbuf, (void *)pbuf,
+                            v0 < 48 ? v0 : 48, false);
+        fprintf(stderr, ":");
+        for (i = 0; i < 48; i++) {
+            fprintf(stderr, " %02x", (unsigned char)pbuf[i]);
+        }
+        fprintf(stderr, " |");
+        for (i = 0; i < 48; i++) {
+            fputc(g_ascii_isprint(pbuf[i]) ? pbuf[i] : '.', stderr);
+        }
+        fprintf(stderr, "|");
+    }
+    fprintf(stderr, "\n");
+}
