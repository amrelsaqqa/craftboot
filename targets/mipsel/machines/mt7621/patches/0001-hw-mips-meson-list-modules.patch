From a04446df1afc6bcbd0d63c832dbc61f9f64b6b96 Mon Sep 17 00:00:00 2001
From: Amr Elsaqqa <amrelsaqqa@hotmail.com>
Date: Sat, 14 Nov 2026 15:43:00 +0200
Subject: [PATCH] mt7621: list the module sources in meson

---
 hw/mips/meson.build | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hw/mips/meson.build b/hw/mips/meson.build
index 2f2fba7..712ac57 100644
--- a/hw/mips/meson.build
+++ b/hw/mips/meson.build
@@ -4,7 +4,7 @@ common_ss.add(when: 'CONFIG_FW_CFG_MIPS', if_true: files('fw_cfg.c'))
 common_ss.add(when: 'CONFIG_LOONGSON3V', if_true: files('loongson3_bootp.c'))
 mips_ss.add(when: 'CONFIG_LOONGSON3V', if_true: files('loongson3_virt.c'))
 mips_ss.add(when: 'CONFIG_MALTA', if_true: files('malta.c'))
-mips_ss.add(when: 'CONFIG_MT7621', if_true: files('mt7621.c'))
+mips_ss.add(when: 'CONFIG_MT7621', if_true: files('mt7621.c', 'mt7621/uart.c', 'mt7621/regfile.c', 'mt7621/wdt.c', 'mt7621/systick.c', 'mt7621/board.c', 'mt7621/flash.c'))
 mips_ss.add(when: 'CONFIG_MIPS_CPS', if_true: files('cps.c'))
 
 if 'CONFIG_TCG' in config_all_accel
