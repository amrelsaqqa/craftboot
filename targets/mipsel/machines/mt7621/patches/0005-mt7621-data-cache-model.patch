diff --git a/include/exec/cpu-dcache.h b/include/exec/cpu-dcache.h
new file mode 100644
index 0000000..a3796d0
--- /dev/null
+++ b/include/exec/cpu-dcache.h
@@ -0,0 +1,26 @@
+/*
+ * Optional data cache hook for the TCG slow path.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * A machine that models the CPU's write-back data cache installs
+ * @cpu_dcache_access_handler.  Pages the guest maps as cacheable are forced
+ * through the slow path, and the handler performs the access against the
+ * cache model instead of RAM; uncached and device accesses never reach it.
+ *
+ * The handler translates @addr itself, serves the access from the cache
+ * (filling and evicting as needed) and returns true if it handled it.
+ */
+#ifndef EXEC_CPU_DCACHE_H
+#define EXEC_CPU_DCACHE_H
+
+#include "exec/cpu-common.h"
+#include "exec/hwaddr.h"
+
+typedef bool (*CPUDCacheAccessHandler)(CPUState *cpu, vaddr addr,
+                                       unsigned size, bool is_write,
+                                       uint64_t *value);
+
+extern CPUDCacheAccessHandler cpu_dcache_access_handler;
+
+#endif
