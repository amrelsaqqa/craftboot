     /*
      * Bus masters which don't specify any attributes will get this
diff --git a/include/exec/mips-dcache.h b/include/exec/mips-dcache.h
new file mode 100644
index 0000000..7d463d9
--- /dev/null
+++ b/include/exec/mips-dcache.h
@@ -0,0 +1,21 @@
+/*
+ * MIPS data cache model hook.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * A machine can model the CPU's data cache (a machine without a cache model,
+ * i.e. plain QEMU, sees KSEG0 and KSEG1 hit the same bytes).  When it does, it
+ * installs @mips_dcache_op and target/mips calls it for every `cache`
+ * instruction so writeback/invalidate reach the model.
+ */
+#ifndef EXEC_MIPS_DCACHE_H
+#define EXEC_MIPS_DCACHE_H
+
+#include "exec/cpu-common.h"
+
+typedef void (*MIPSDCacheOpHandler)(CPUState *cs, vaddr addr,
+                                    unsigned type, unsigned op);
+
+extern MIPSDCacheOpHandler mips_dcache_op;
+
+#endif
diff --git a/target/mips/internal.h b/target/mips/internal.h
index 28eb289..cc9797a 100644
--- a/target/mips/internal.h
+++ b/target/mips/internal.h
@@ -112,6 +112,14 @@ enum {
     TLBRET_MATCH = 0
 };
 
+/*
+ * MIPS C (cacheability) field of the mapping for @address: 0..5.  Segments
+ * that are not TLB-mapped take it from the SegmentControl register, TLB
+ * mapped pages from their entry.  3/4/5 mean cacheable.
+ */
+bool mips_mapping_is_cacheable(CPUMIPSState *env, target_ulong address,
+                               MMUAccessType access_type, int mmu_idx);
+
 int get_physical_address(CPUMIPSState *env, hwaddr *physical,
                          int *prot, target_ulong real_address,
                          MMUAccessType access_type, int mmu_idx);
diff --git a/target/mips/system/physaddr.c b/target/mips/system/physaddr.c
index b8e1a5a..d49a83d 100644
--- a/target/mips/system/physaddr.c
+++ b/target/mips/system/physaddr.c
@@ -19,6 +19,7 @@
 #include "qemu/osdep.h"
 #include "cpu.h"
 #include "exec/page-protection.h"
+#include "exec/target_page.h"
 #include "../internal.h"
 
 static int is_seg_am_mapped(unsigned int am, bool eu, int mmu_idx)
@@ -240,3 +241,65 @@ hwaddr mips_cpu_get_phys_page_debug(CPUState *cs, vaddr addr)
     }
     return phys_addr;
 }
+
+/*
+ * The MIPS C (cacheability) field of the mapping for @address.  Unmapped
+ * segments carry it in their SegmentControl register (kseg0 defaults to 3,
+ * kseg1 to 2); TLB mapped pages carry it in the entry they resolve to.  A
+ * qemu model has no caches, so this only matters to a machine that models
+ * one: C >= 3 is cacheable, C <= 2 is uncached.
+ */
+static unsigned int tlb_page_cacheability(CPUMIPSState *env, target_ulong address)
+{
+    uint16_t ASID = env->CP0_EntryHi & env->CP0_EntryHi_ASID_mask;
+    uint32_t MMID = env->CP0_MemoryMapID;
+    bool mi = !!((env->CP0_Config5 >> CP0C5_MI) & 1);
+    uint32_t want = mi ? MMID : (uint32_t)ASID;
+    int i;
+
+    for (i = 0; i < env->tlb->tlb_in_use; i++) {
+        r4k_tlb_t *tlb = &env->tlb->mmu.r4k.tlb[i];
+        target_ulong mask = tlb->PageMask | ~(TARGET_PAGE_MASK << 1);
+        target_ulong tag = address & ~mask;
+        target_ulong vpn = tlb->VPN & ~mask;
+        uint32_t have = mi ? tlb->MMID : (uint32_t)tlb->ASID;
+
+        if (tlb->EHINV || !(tlb->G == 1 || have == want) || vpn != tag) {
+            continue;
+        }
+        return (address & mask & ~(mask >> 1)) ? tlb->C1 : tlb->C0;
+    }
+    return 3;                   /* not mapped: behave as cacheable */
+}
+
+static unsigned int segment_cacheability(CPUMIPSState *env, target_ulong address)
+{
+    uint64_t segctl;
+
+    if (address < KSEG1_BASE) {
+        segctl = env->CP0_SegCtl1 >> 16;         /* kseg0 */
+    } else if (address < KSEG2_BASE) {
+        segctl = env->CP0_SegCtl1;              /* kseg1 */
+    } else if (address < KSEG3_BASE) {
+        segctl = env->CP0_SegCtl0 >> 16;        /* kseg2 */
+    } else {
+        segctl = env->CP0_SegCtl0;              /* kseg3 */
+    }
+    return (segctl & CP0SC_C_MASK) >> CP0SC_C;
+}
+
+bool mips_mapping_is_cacheable(CPUMIPSState *env, target_ulong address,
+                               MMUAccessType access_type, int mmu_idx)
+{
+    unsigned int c;
+
+    if (address < KSEG0_BASE) {
+        /* useg/xuseg: resolved through the TLB */
+        c = tlb_page_cacheability(env, address);
+    } else {
+        c = segment_cacheability(env, address);
+    }
+    (void)access_type;
+    (void)mmu_idx;
+    return c >= 3;
+}
