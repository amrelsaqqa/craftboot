         gic->vps[vp_index].other_addr = data;
@@ -441,7 +585,18 @@ static void gic_reset(void *opaque)
                      (numintrs     << GIC_SH_CONFIG_NUMINTRS_SHF)  |
                      (gic->num_vps << GIC_SH_CONFIG_PVPS_SHF);
     for (i = 0; i < gic->num_vps; i++) {
-        gic->vps[i].ctl         = 0x0;
+        /*
+         * GIC_VPE_CTL reports which VP-local interrupts this implementation
+         * can route to a CPU pin.  Bit 1 is TIMER_ROUTABLE: the CP0 count/
+         * compare interrupt.  Reporting 0 made Linux's
+         * gic_get_c0_compare_int() return the CPU's IP7 instead, so a guest
