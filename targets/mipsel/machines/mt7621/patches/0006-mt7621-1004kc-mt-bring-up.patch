+/*
+ * Rate summary for the interrupt inputs: a source that fires hundreds of
+ * times per second is a storm (an unacknowledged level), and printing one
+ * line per second is far more useful than a per-transition flood that runs
+ * out of budget before the interesting moment.
+ */
+static int gic_shared_level[64];
+static int gic_local_level[8];
+
+void mips_gic_level_report(void)
+{
+    static int64_t last;
+    int64_t now = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+    int i;
+
+    if (!getenv("MT7621_GICIRQLOG") || now - last < 1000) {
+        return;
+    }
+    last = now;
+    for (i = 0; i < 64; i++) {
+        if (gic_shared_level[i]) {
+            fprintf(stderr, "giclevel: shared %d held high\n", i);
+        }
+    }
+    for (i = 0; i < 8; i++) {
+        if (gic_local_level[i]) {
+            fprintf(stderr, "giclevel: local %d held high\n", i);
+        }
+    }
+}
+
+static void gic_rate_log(const char *kind, int n, int level)
+{
+    static struct {
+        int64_t win;
+        uint32_t n;
+    } r[64], l[8];
+    int64_t now;
+    uint32_t *cnt;
+
+    if (!getenv("MT7621_GICIRQLOG")) {
+        return;
+    }
+    if (n >= 0 && n < 64) {
+        if (kind[0] == 's') {
+            gic_shared_level[n] = level;
+        } else if (n < 8) {
+            gic_local_level[n] = level;
+        }
+    }
+    if (!level) {
+        return;
+    }
+    now = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+    if (n < 0 || n >= 64) {
+        return;
+    }
+    cnt = kind[0] == 's' ? &r[n].n : &l[n].n;
+    {
+        int64_t *win = kind[0] == 's' ? &r[n].win : &l[n].win;
+
+        if (now - *win >= 1000) {
+            if (*cnt > 200) {
+                fprintf(stderr, "gicrate: %s %d = %u/s\n", kind, n, *cnt);
+            }
+            *cnt = 0;
+            *win = now;
+        }
+    }
+    (*cnt)++;
+}
+
 static void gic_set_irq(void *opaque, int n_IRQ, int level)
 {
     MIPSGICState *gic = (MIPSGICState *) opaque;
 
+    if (getenv("MT7621_GICIRQLOG") && !getenv("MT7621_QUIET")) {
