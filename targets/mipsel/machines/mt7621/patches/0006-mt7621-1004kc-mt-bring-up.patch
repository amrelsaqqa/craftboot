diff --git a/target/mips/system/cp0_timer.c b/target/mips/system/cp0_timer.c
index ca16945..bfe0ca9 100644
--- a/target/mips/system/cp0_timer.c
+++ b/target/mips/system/cp0_timer.c
@@ -26,6 +26,32 @@
 #include "system/kvm.h"
 #include "internal.h"
 
+/*
+ * Deliver the CP0 count/compare interrupt.  On a core covered by a Coherence
+ * Manager this is not a CPU interrupt pin at all: it is the GIC's VP-local
+ * interrupt GIC_LOCAL_INT_TIMER, gated by the GIC's VP mask/map, and a SoC
+ * with a CM overrides this hook to drive it there.  The default is the
+ * pre-CM behaviour (Cause.IP7 / IntCtl.IPTI), used by machines without a CM.
+ */
+__attribute__((weak)) void cpu_mips_timer_irq(CPUMIPSState *env, int level)
+{
+    int irq;
+
+    /*
+     * With a vectorizing external interrupt controller the core does not own
+     * interrupt delivery: Cause.IP is a vector level and the EIC feeds it.
+     */
+    if (env->CP0_Config3 & (1 << CP0C3_VEIC)) {
+        return;
+    }
+    irq = (env->CP0_IntCtl >> CP0IntCtl_IPTI) & 0x7;
+    if (level) {
+        qemu_irq_raise(env->irq[irq]);
+    } else {
+        qemu_irq_lower(env->irq[irq]);
+    }
+}
+
 /* MIPS R4K timer */
 static uint32_t cpu_mips_get_count_val(CPUMIPSState *env)
 {
@@ -53,11 +79,28 @@ static void cpu_mips_timer_update(CPUMIPSState *env)
 /* Expire the timer.  */
 static void cpu_mips_timer_expire(CPUMIPSState *env)
 {
+    if (getenv("MT7621_TMRLOG")) {
+        fprintf(stderr, "cp0tmr: cpu%d expire count=%08x compare=%08x ipti=%u cfg3=%08x\n",
+                env_cpu(env)->cpu_index, env->CP0_Count, env->CP0_Compare,
+                (env->CP0_IntCtl >> CP0IntCtl_IPTI) & 0x7,
+                env->CP0_Config3);
+    }
     cpu_mips_timer_update(env);
     if (env->insn_flags & ISA_MIPS_R2) {
         env->CP0_Cause |= 1 << CP0Ca_TI;
     }
-    qemu_irq_raise(env->irq[(env->CP0_IntCtl >> CP0IntCtl_IPTI) & 0x7]);
+    /*
+     * With a vectorizing external interrupt controller (Config3.VEIC) the
+     * core does not own interrupt delivery: Cause.IP is a vector level
+     * (cpu_mips_hw_interrupts_pending() compares pending > status) and the
+     * EIC, here the GIC, feeds the vector.  Raising env->irq[IPTI] in that
+     * mode injects a bare vector number - on the mt7621/1004K that shows up
+     * as an unhandled "irq 7: nobody cared" storm, because the guest's
+     * timekeeping is the GIC compare interrupt and nothing claims that
+     * vector.  Leave Cause.TI set (the guest may poll it) and let the EIC
+     * deliver the timer.
+     */
+    cpu_mips_timer_irq(env, 1);
 }
 
 uint32_t cpu_mips_get_count(CPUMIPSState *env)
@@ -96,16 +139,58 @@ void cpu_mips_store_count(CPUMIPSState *env, uint32_t count)
     }
 }
 
+/*
+ * A guest arms the compare from a Count value it has just read, typically
+ * "write_c0_compare(read_c0_count() + delta)".  The count this model exposes
+ * is derived from the host clock, so by the time the mtc0 is emulated the
+ * count has already moved on by the host's call latency - a small delta then
+ * arrives *behind* the count.  Hardware evaluates the compare at the instant
+ * of the write, where that value is still ahead; taking the wrap-around
+ * interpretation here would make the compare disappear for the next 2^32
+ * ticks (about 4.9 s at 880 MHz).
+ *
+ * Linux's c0_compare_int_usable() probes exactly this, allowing only 50
+ * ticks, before registering its IP7 handler; when the probe fails the timer
+ * interrupt has no handler at all, which is the "irq 7: nobody cared" storm.
+ * Such a fresh arm is therefore scheduled to expire immediately.  Only a
+ * fresh arm is: a write that acknowledges an already-pending compare must
+ * keep the wrap semantics, or the handler would re-trigger itself forever.
+ * MT7621_NO_CMP_CLAMP=1 disables the compensation for A/B.
+ */
+#define CP0_COMPARE_SKEW_NS 10000
+
 void cpu_mips_store_compare(CPUMIPSState *env, uint32_t value)
 {
+    bool pending = !!(env->CP0_Cause & (1 << CP0Ca_TI));
+
+    if (getenv("MT7621_TMRLOG")) {
+        fprintf(stderr, "cp0tmr: cpu%d store_compare %08x pc=%08x dc=%d "
+                "count=%08x wait=%08x ti=%d\n",
+                env_cpu(env)->cpu_index, value, (uint32_t)env->active_tc.PC,
+                !!(env->CP0_Cause & (1 << CP0Ca_DC)),
+                cpu_mips_get_count_val(env),
+                (uint32_t)(value - cpu_mips_get_count_val(env)),
+                pending);
+    }
     env->CP0_Compare = value;
     if (!(env->CP0_Cause & (1 << CP0Ca_DC))) {
-        cpu_mips_timer_update(env);
+        uint32_t count = cpu_mips_get_count_val(env);
+        int32_t behind = (int32_t)(count - value);
+        int64_t skew = clock_ns_to_ticks(env->count_clock,
+                                        CP0_COMPARE_SKEW_NS);
+
+        if (!getenv("MT7621_NO_CMP_CLAMP") &&
+            !pending && behind >= 0 && behind <= skew) {
+            timer_mod(env->timer,
+                      qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1);
+        } else {
+            cpu_mips_timer_update(env);
+        }
     }
     if (env->insn_flags & ISA_MIPS_R2) {
         env->CP0_Cause &= ~(1 << CP0Ca_TI);
     }
-    qemu_irq_lower(env->irq[(env->CP0_IntCtl >> CP0IntCtl_IPTI) & 0x7]);
+    cpu_mips_timer_irq(env, 0);
 }
 
 void cpu_mips_start_count(CPUMIPSState *env)
