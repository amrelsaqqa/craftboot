+        }
+    }
+    gic_rate_log("shared", n_IRQ, level);
+
     if (gic_log_on()) {
         static int budget = 200;
         if (budget-- > 0) {
@@ -149,6 +237,8 @@ static uint64_t gic_read_vp(MIPSGICState *gic, uint32_t vp_index, hwaddr addr,
         return gic->vps[vp_index].mask;
     case GIC_VP_COMPARE_MAP_OFS:
         return gic->vps[vp_index].compare_map;
+    case GIC_VP_TIMER_MAP_OFS:
+        return gic->vps[vp_index].timer_map;
     case GIC_VP_OTHER_ADDR_OFS:
         return gic->vps[vp_index].other_addr;
     case GIC_VP_IDENT_OFS:
@@ -252,30 +342,77 @@ bad_offset:
     return 0;
 }
 
+void mips_gic_local_irq(MIPSGICState *gic, uint32_t vp, int intr, int level)
+{
+    uint32_t bit = 1u << intr;
+    uint32_t map;
+
+    if (vp >= gic->num_vps) {
+        return;
+    }
+
+    if (getenv("MT7621_GICIRQLOG") && !getenv("MT7621_QUIET")) {
+        static int budget = 400000;
+        static int last_level[64];
+
+        /* only local 2 (CP0 compare routed through the GIC), only changes */
+        if (intr == GIC_LOCAL_INT_TIMER && vp < 64 &&
+            last_level[vp] != level && budget-- > 0) {
+            MIPSCPU *cpu = MIPS_CPU(qemu_get_cpu(vp));
+
+            last_level[vp] = level;
+            fprintf(stderr, "gicirq2: t=%lldms vp%u <- %d pc=%08x mask=%08x "
+                    "tmap=%08x pend=%08x\n",
+                    (long long)(qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL)),
+                    vp, level,
+                    cpu ? (uint32_t)cpu->env.active_tc.PC : 0,
+                    gic->vps[vp].mask, gic->vps[vp].timer_map,
+                    gic->vps[vp].pend);
+        }
+    }
+    gic_rate_log("local", intr, level);
+    if (level) {
+        gic->vps[vp].pend |= bit;
+    } else {
+        gic->vps[vp].pend &= ~bit;
+    }
+
+    switch (intr) {
+    case GIC_LOCAL_INT_COMPARE:
+        map = gic->vps[vp].compare_map;
+        break;
+    case GIC_LOCAL_INT_TIMER:
+        map = gic->vps[vp].timer_map;
+        break;
+    default:
+        /* The remaining local sources are not modelled; they latch only. */
+        return;
+    }
+
+    if (map & GIC_MAP_TO_PIN_MSK) {
+        /*
+         * Recompute the whole pin: it may carry shared interrupts and the
+         * other local source, and the mask is applied by that helper.  This
+         * also lowers the pin when the source is acknowledged.
+         */
+        mips_gic_set_vp_irq(gic, vp, map & GIC_MAP_MSK);
+    }
+}
+
