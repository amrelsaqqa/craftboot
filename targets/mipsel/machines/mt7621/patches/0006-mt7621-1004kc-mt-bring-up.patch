@@ -222,4 +223,14 @@ struct MIPSGICState {
     uint32_t counter_bits;
 };
 
+/*
+ * Drive one of the VP-local interrupt sources (GIC_LOCAL_INT_*), as the core
+ * does for its CP0 count/compare interrupt (GIC_LOCAL_INT_TIMER) and the GIC
+ * timer does for its own compare (GIC_LOCAL_INT_COMPARE).  The source latches
+ * in GIC_VP_PEND; it only reaches a CPU interrupt pin when the VP mask bit is
+ * set and the local interrupt's map register points at a pin - which is how
+ * a guest enables it (gic_all_vpes_local_irq_controller / the EIC setup).
+ */
+void mips_gic_local_irq(MIPSGICState *gic, uint32_t vp, int intr, int level);
+
 #endif /* MIPS_GIC_H */
