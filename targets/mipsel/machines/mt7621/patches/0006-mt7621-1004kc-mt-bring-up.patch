     MIPSGICState *gic = opaque;
 
-    gic->vps[vp_index].pend |= (1 << GIC_LOCAL_INT_COMPARE);
-    if (gic->vps[vp_index].pend &
-            (gic->vps[vp_index].mask & GIC_VP_MASK_CMP_MSK)) {
