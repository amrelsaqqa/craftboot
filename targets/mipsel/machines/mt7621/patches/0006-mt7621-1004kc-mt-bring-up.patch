+         * (giclevel: local 2 held high) and eventually wedging a CPU.
+         */
+        gic->vps[i].ctl         = (1u << 1);   /* TIMER_ROUTABLE */
         gic->vps[i].pend        = 0x0;
         /* PERFCNT, TIMER and WD not implemented */
         gic->vps[i].mask        = 0x32;
diff --git a/include/hw/intc/mips_gic.h b/include/hw/intc/mips_gic.h
index 4c61e99..ccd052b 100644
--- a/include/hw/intc/mips_gic.h
+++ b/include/hw/intc/mips_gic.h
@@ -193,6 +193,7 @@ struct MIPSGICVPState {
     uint32_t pend;
